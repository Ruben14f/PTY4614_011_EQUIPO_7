        <mxCell id="Zt51Z_KIFmKUzO5cO20j-18" parent="1" style="text;whiteSpace=wrap;html=1;horizontal=1;fontSize=19;" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 33px; line-height: 130%;&quot;&gt;&lt;b&gt;Lectura:&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;ul&gt;&lt;li&gt;&lt;span&gt;El diagrama representa la organización lógica de GATI en capas de presentación, lógica de negocio y acceso a datos.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Las flechas indican comunicación y dependencias funcionales entre capas, no una secuencia de ejecución.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Firebase Authentication proporciona autenticación como servicio transversal.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Cloud Firestore permite la persistencia y trazabilidad de la información.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;El Sistema de Compras es externo a GATI y se integra mediante API REST (HTTPS/JSON).&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Firebase Hosting corresponde a la infraestructura de despliegue web y no se representa en esta vista.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="235.42" width="1211.34" x="144" y="1592" as="geometry" />
        </mxCell>
      </root>
