        <mxCell id="KrmTSp65260v01p0B9Ct-3" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=17;" value="&lt;p&gt;&lt;strong&gt;&lt;span&gt;Lectura:&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span&gt;El diagrama representa la estructura estática del sistema GATI mediante clases, atributos, operaciones y relaciones.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Cada clase se divide en nombre, atributos y operaciones; los símbolos &lt;/span&gt;&lt;b&gt;&lt;code&gt;&lt;span&gt;+&lt;/span&gt;&lt;/code&gt;&lt;/b&gt;&lt;span&gt;&lt;b&gt; &lt;/b&gt;y &lt;/span&gt;&lt;b&gt;&lt;code&gt;&lt;span&gt;-&lt;/span&gt;&lt;/code&gt;&lt;/b&gt;&lt;span&gt;&lt;b&gt; &lt;/b&gt;indican visibilidad pública y privada, respectivamente.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Las líneas continuas representan asociaciones entre las clases del dominio.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Las clases &lt;/span&gt;&lt;b&gt;&lt;code&gt;&lt;span&gt;Activo&lt;/span&gt;&lt;/code&gt;&lt;span&gt;, &lt;/span&gt;&lt;code&gt;&lt;span&gt;Hardware&lt;/span&gt;&lt;/code&gt;&lt;/b&gt;&lt;span&gt; y &lt;/span&gt;&lt;b&gt;&lt;code&gt;&lt;span&gt;LicenciaSoftware&lt;/span&gt;&lt;/code&gt;&lt;/b&gt;&lt;span&gt;&lt;b&gt; &lt;/b&gt;representan los activos tecnológicos administrados por GATI.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Las clases &lt;/span&gt;&lt;b&gt;&lt;code&gt;&lt;span&gt;Asignacion&lt;/span&gt;&lt;/code&gt;&lt;/b&gt;&lt;span&gt;, &lt;/span&gt;&lt;b&gt;&lt;code&gt;&lt;span&gt;Acta&lt;/span&gt;&lt;/code&gt;&lt;/b&gt;&lt;span&gt;&lt;b&gt; &lt;/b&gt;y &lt;/span&gt;&lt;b&gt;&lt;code&gt;&lt;span&gt;EventoHistorial&lt;/span&gt;&lt;/code&gt;&lt;/b&gt;&lt;span&gt;&lt;b&gt; &lt;/b&gt;permiten modelar la entrega, devolución y trazabilidad de los activos.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;El diagrama describe la estructura lógica del sistema, no su almacenamiento físico en Cloud Firestore.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="208.68" width="1063.17" x="123" y="1342" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
