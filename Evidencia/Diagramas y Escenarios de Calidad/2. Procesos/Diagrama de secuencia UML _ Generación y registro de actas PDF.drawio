        <mxCell id="ncRYfpXT8jFKvEpfdRGG-338" connectable="0" parent="ncRYfpXT8jFKvEpfdRGG-337" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;18.&amp;nbsp;Rechazar generación&lt;/font&gt;" vertex="1">
          <mxGeometry relative="1" x="-0.3365" y="1" as="geometry">
            <mxPoint x="46" y="-18" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wS8KMqPOFz-5aCnO15Bm-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;strong&gt;&lt;span&gt;Lectura:&lt;/span&gt;&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;span&gt;El diagrama representa las interacciones necesarias para generar y registrar un acta PDF asociada a una asignación o devolución de activos tecnológicos.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;span&gt;El Técnico de Soporte solicita la generación del acta mediante la aplicación GATI.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;span&gt;Gestión de Actas consulta los datos de la operación, utilizando Gestión de Asignaciones y Cloud Firestore.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;span&gt;Los fragmentos &lt;/span&gt;&lt;code&gt;&lt;span&gt;alt&lt;/span&gt;&lt;/code&gt;&lt;span&gt; representan los resultados alternativos según la validez de los datos, la generación del documento y su registro.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;span&gt;Si los datos son válidos, GATI genera el documento PDF y registra su vinculación con la operación correspondiente.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;span&gt;Si el registro es exitoso, el sistema habilita la descarga del acta; en caso contrario, informa el error.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;span&gt;Las flechas continuas representan solicitudes entre participantes y las discontinuas indican respuestas. El diagrama describe el orden de las interacciones, no la infraestructura física del sistema.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="1642" x="75" y="1659" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
