        <mxCell id="UL85llyuREWyK2cH2xk2-58" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=13;" value="&lt;p&gt;&lt;strong&gt;&lt;span&gt;Lectura:&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span&gt;El diagrama representa el flujo de actividades para devolver un activo tecnológico y determinar su posible reasignación.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;El proceso comienza con la identificación y validación de una asignación vigente.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Los rombos representan decisiones que determinan las rutas alternativas del proceso.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Si el activo es devuelto correctamente, GATI registra la devolución, actualiza su estado e historial y genera el acta correspondiente.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Si el activo está apto y existe una reasignación inmediata válida, se registra la nueva asignación y se genera el acta de entrega.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Si no corresponde reasignarlo, el activo queda disponible en inventario o se registra como no apto, según su condición.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Las flechas indican el flujo de control entre actividades; todas las rutas concluyen en un único nodo final.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="160" width="1110" x="2033.82" y="1020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
