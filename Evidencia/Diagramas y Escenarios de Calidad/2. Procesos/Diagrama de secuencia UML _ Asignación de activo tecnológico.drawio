        <mxCell id="ncRYfpXT8jFKvEpfdRGG-151" connectable="0" parent="ncRYfpXT8jFKvEpfdRGG-150" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=#FFFFFF;fontStyle=0;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;18.&amp;nbsp;&lt;code&gt;&lt;span&gt;&lt;font face=&quot;Helvetica&quot;&gt;asignacionRechazada(motivos)&lt;/font&gt;&lt;/span&gt;&lt;/code&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry relative="1" x="-0.1439" y="4" as="geometry">
            <mxPoint x="169" y="-24" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vvxpSXv8eUsDLdl-140P-2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#17365D;rounded=1;roundedPerimeter=1;strokeColor=light-dark(#0080ff, #5c79a3);strokeWidth=3;fillColor=#000066;" value="&lt;blockquote&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(247, 238, 252);&quot;&gt;VISTA DE PROCESOS &lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); font-weight: normal;&quot;&gt;(modelo 4+1)&lt;/span&gt;&lt;span style=&quot;color: rgb(247, 238, 252);&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;DIAGRAMA DE SECUENCIA&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(255, 255, 255); font-weight: normal;&quot;&gt;&lt;b&gt;Representación&lt;/b&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); font-weight: normal;&quot;&gt;Asignación de un activo tecnologico&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(255, 255, 255); font-weight: normal;&quot;&gt;&lt;b&gt;Tipo&lt;/b&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 255, 255); font-weight: normal;&quot;&gt;UML - Comportamiento&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="170" width="781" x="35" y="20" as="geometry" />
        </mxCell>
        <mxCell id="hfw5z87PN3apJFX6Hjy6-7" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;" value="&lt;p&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;strong&gt;&lt;span&gt;Lectura:&lt;/span&gt;&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span&gt;El diagrama representa la interacción entre el Técnico de Soporte, las aplicaciones Web y Móvil, los servicios de asignaciones e inventario, la capa de acceso a datos y Cloud Firestore.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span&gt;El fragmento &lt;/span&gt;&lt;code&gt;&lt;span&gt;alt&lt;/span&gt;&lt;/code&gt;&lt;span&gt; inicial muestra dos alternativas para solicitar una asignación: mediante la aplicación web o mediante la aplicación móvil.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span&gt;El servicio de asignaciones solicita verificar la disponibilidad del activo antes de registrar la operación.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span&gt;Las flechas continuas representan solicitudes o llamadas entre participantes; las discontinuas indican respuestas.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span&gt;Si el activo está disponible, GATI registra la asignación, actualiza la información del activo y confirma la operación.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span&gt;Si la asignación es rechazada, el sistema informa el motivo y no registra la operación.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span&gt;El diagrama representa el orden de las interacciones, no la distribución física de los componentes.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="273" width="1577" x="113" y="1627" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
