        <mxCell id="-FdCGuNzvrtB02ndjJJH-31" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p&gt;&lt;strong&gt;&lt;span&gt;Lectura:&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span&gt;El diagrama representa los estados por los que puede pasar un activo tecnológico durante su ciclo de vida en GATI.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;El activo comienza como &lt;/span&gt;&lt;strong&gt;&lt;span&gt;Pendiente de registro&lt;/span&gt;&lt;/strong&gt;&lt;span&gt; y, una vez registrado e individualizado, pasa a &lt;/span&gt;&lt;strong&gt;&lt;span&gt;Disponible&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Cuando se entrega a un funcionario, cambia a &lt;/span&gt;&lt;strong&gt;&lt;span&gt;Asignado&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Al registrar su devolución, pasa a &lt;/span&gt;&lt;strong&gt;&lt;span&gt;En revisión&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;, donde se evalúa su condición.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Si el activo está apto, vuelve a &lt;/span&gt;&lt;strong&gt;&lt;span&gt;Disponible&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;, permitiendo una nueva asignación.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Si no está apto, pasa a &lt;/span&gt;&lt;strong&gt;&lt;span&gt;No disponible&lt;/span&gt;&lt;/strong&gt;&lt;span&gt; y, una vez aprobada su baja, cambia a &lt;/span&gt;&lt;strong&gt;&lt;span&gt;Dado de baja&lt;/span&gt;&lt;/strong&gt;&lt;span&gt;, finalizando su ciclo de vida.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;Las flechas representan transiciones entre estados; sus etiquetas indican los eventos o condiciones que provocan cada cambio.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="150" width="899.74" x="2020" y="1020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
